@startuml descriptor-governance
' Sources:
'   src/charter/offering/drg/models.py        (DRGGraph, DRGNode, DRGEdge, NodeKind, Relation)
'   src/charter/activation/org_charter.py     (OrgCharterPolicy -> org-charter.yaml)
'   src/charter/activation/schemas.py         (GovernanceCharterConfig)
'   src/charter/offering/packs/pack_descriptor.py (PackDescriptor -> pack.yaml)
'   see also core src/charter/diagrams/pack-descriptor-model.puml
!include _style.iuml
title Pack, DRG and charter configuration schemas

class PackDescriptor <<pack.yaml>> {
  + pack_id : string [ULID]
  - pack_version : string [required iff pack_level=built-in]
  - parent_pack : string
  + name : string
  + pack_level : PackTier
  - requires_core : string
  - active_charter : path
  - pack_drg : path
}
class DRGGraph <<*.graph.yaml / drg/fragment.yaml>> {
  + schema_version : "1.0"
  + generated_at : string
  + generated_by : string
  + nodes : DRGNode[]
  + edges : DRGEdge[]
}
class DRGNode {
  + urn : string  "<kind>:<id>"
  + kind : NodeKind
  - label : string
  - provenance : string
  - tags : string[] = []
}
class DRGEdge {
  + source : string [URN or bare id]
  + target : string [URN or bare id]
  + relation : Relation
  - when : string
  - reason : string
  - provenance : string
}
enum NodeKind {
  directive, tactic, paradigm, styleguide,
  toolguide, procedure, agent_profile,
  mission_step_contract, template, asset,
  action, glossary_scope, glossary,
  glossary_pack, mission_type, anti_pattern, skill
}
enum Relation {
  requires, suggests, applies, scope,
  vocabulary, instantiates, replaces,
  delegates_to, specializes_from, enhances,
  overrides, refines, in_tension_with,
  reconciles_tension, rejects
}
class OrgCharterPolicy <<org-charter.yaml>> {
  - schema_version : int
  - extends : string
  - org_name : string
  - interview_defaults : map<string, string|bool>
  - required_directives, required_tactics,
    required_paradigms, required_styleguides,
    required_toolguides, required_procedures,
    required_agent_profiles,
    required_mission_step_contracts,
    required_glossary_packs, required_assets,
    required_skills : string[] = []
  - skill_namespace : string
  - governance_policies : GovernancePolicy[] = []
  - activations : ActivationEntry[] = []
}
class GovernancePolicy {
  + field : string
  + value : string|bool
  - enforcement : string = "advisory"
}
class GovernanceCharterConfig <<project charter>> {
  - selected_paradigms, selected_directives,
    selected_tactics, selected_styleguides,
    selected_toolguides, selected_procedures,
    selected_agent_profiles,
    selected_mission_step_contracts,
    selected_glossary_packs, selected_assets : string[] = []
  - available_tools : string[]
  - template_set : string
  - authority_paths : string[]
  - governance_references : string[]
}
PackDescriptor --> "0..1" DRGGraph : pack_drg
PackDescriptor --> "0..1" OrgCharterPolicy : active_charter
OrgCharterPolicy *-- "*" GovernancePolicy
DRGGraph *-- "*" DRGNode
DRGGraph *-- "*" DRGEdge
DRGNode --> NodeKind
DRGEdge --> Relation
DRGEdge ..> DRGNode : source / target
OrgCharterPolicy ..> GovernanceCharterConfig : required_* union into selected_*\n(selection_overlayable kinds)
@enduml
