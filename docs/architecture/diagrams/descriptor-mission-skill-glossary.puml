@startuml descriptor-mission-skill-glossary
' Sources:
'   src/charter/offering/schemas/skill.schema.yaml + pack_skills/models.py (PackSkill)
'   contracts/packs/schemas/glossary.schema.json (GlossaryContext, Term; ADR-0049, built in #106)
' Notation: + required, - optional (Pydantic default shown after =).
' Built: the glossary context (ADR-0049, ADR-0053 d11 to d14); the kind glossary replaced glossary_pack outright (#106).
' PackSkill is unchanged. The mission step contract this diagram drew is retired (ADR-0077): a step's substeps are in
' the mission type, drawn in descriptor-mission-type-lifecycle.puml.
!include _style.iuml
title Pack skill and glossary context descriptor schemas — glossary built (ADR-0049)

class PackSkill <<skill.schema.yaml>> {
  + schema_version : "1.0"
  + id : string [<=64] ~ id pattern (see note)
  + title : string
  + description : string
  + form : prompt | wrapper
  - body_path : string [required iff form=prompt]
  - expands_to : SkillExpansion [required iff form=wrapper]
  - triggers : string[] = []
  - parameters : SkillParameter[] = []
  - invocation : SkillInvocation
  - tools : string[] = ["*"]
  - version : string = "1.0.0"
  - maintainers : string[]
  - overrides : string
  - enhances : string
}
class SkillExpansion {
  + target : string ~ builtin:... | cli:spec-kitty ...
  - args : string
}
class SkillParameter {
  + name : string
  - required : bool = false
  - description : string
  - default : string
}
class SkillInvocation {
  - user_invocable : bool = true
  - model_invocable : bool = true
  - side_effects : string[]
}
PackSkill *-- "0..1" SkillExpansion
PackSkill *-- "*" SkillParameter
PackSkill *-- "0..1" SkillInvocation

class GlossaryContext <<glossary.schema.json (ADR-0049 d1, d2)>> {
  + schema_version : "1.0"
  + id : string [<=64] (kebab-case, the file stem)
  + name : string
  + description : string (its applicability)
  - tags : string[1..]
  - applies_to : AppliesTo (advisory, ADR-0049 d14)
  + terms : Term[1..]
  --
  file: glossaries/<context-id>.glossary.yaml (ADR-0053 d11)
  kind glossary; URN glossary_context:<id> (ADR-0053 d13)
}
class AppliesTo {
  - paths : string[1..] (globs)
  - languages : string[1..]
  - stacks : string[1..]
}
class Term <<an item inside a context, not an artifact (d3)>> {
  + id : string [<=64] (kebab-case, unique in the context)
  + name : string (canonical surface form)
  + definition : string
  - examples : string[]
  - aliases : string[]
  - avoid : string[]
  + status : TermStatus (ADR-0053 d14)
  - see_also : string[1..] (term references, bare or <pack>::)
  --
  URN term:<context-id>/<term-id> (d4)
}
enum TermStatus {
  draft
  active
  deprecated
}
GlossaryContext *-- "1..*" Term
GlossaryContext *-- "0..1" AppliesTo
Term --> TermStatus
Term ..> Term : see_also (derives a vocabulary edge\nfrom the context)
note bottom of Term
  Dropped (d5): confidence, introduced_in_mission, provenance.
  surface becomes name; synonyms_to_avoid becomes avoid;
  banned_synonyms folds into avoid.
  A context overrides whole across levels (ADR-0076 d1).
  Retired: glossary_packs/*.glossary-pack.yaml, refused by name.
end note
note right of PackSkill
  id pattern (skill.schema.yaml:21):
  ""^(?!.*<U+005C>n)[a-z][a-z0-9]*(-[a-z0-9]+)*$""
end note
legend right
  + required, - optional.
  MissionStepContract: decided design (ADR-0050), not built yet.
  GlossaryContext and Term: built (#106).
endlegend
@enduml
