@startuml graph-walk-classes
' Sources:
'   service/kernel (kernel.domain): GraphWalker, Descent, CharterRefusal
'   service/kernel (kernel.validation): Rule, ModularRuleset, Constraint, Rationale, Reason, ReasonCode, Severity, Location, Origin
'   service/packs (packs.domain): ValidationWalker, PackGraph, GraphCheck, Ledger, ClosureFault
'   service/packs (packs.domain.graph): PackGraphNode, PackNode, ArtifactNode, EdgeNode, EdgeKind, Scope
'   service/packs (packs.domain.rules): PackRulesets; (packs.application): PackRefusals
'   service/packs (packs.infra.api): PackRegistrationController
'   service/pack-validation: PackVerdicts, PackCheck; service/pack-doctor: PackDoctorMain
'   Decided: ADR-0082 (the domain owns every graph walk). Slices 1 to 3 (#614, #637, #638) are built; the type design is on architectural-patterns-applied.md.
' Notation: a <<proposed>> class or member is part of the approved target design, not built yet; every other one exists.
!include _style.iuml
set separator none
skinparam class<<proposed>> {
  BackgroundColor #E8F4EA
  BorderColor #2E7D32
}
skinparam enum<<proposed>> {
  BackgroundColor #E8F4EA
  BorderColor #2E7D32
}
skinparam interface<<proposed>> {
  BackgroundColor #E8F4EA
  BorderColor #2E7D32
}
title One graph walk, domain rules, one rationale (ADR-0082)

package "kernel (generic, framework-free)" {
  interface "GraphWalker<N, E>" as GraphWalker {
    + onNode(node : N) : Descent
    + onRelationship(relationship : E) : Descent
  }
  enum Descent {
    CONTINUE
    SKIP
    STOP
  }
  interface "Rule<T>" as Rule {
    + apply(subject : T) : List<Reason>
    + on(focus) / forEach(parts) / when(applicable)
    + check(subject : T) : Rationale
    + guard(subject : T)
  }
  class "ModularRuleset<T>" as ModularRuleset {
    + {static} of(rules) : ModularRuleset<T>
    + guard(subject : T) (overrides)
  }
  class "Constraint<T>" as Constraint {
    a Rule with a predicate
    that explains its verdict
  }
  class Rationale {
    every Reason, in order
  }
  class Reason <<record>> {
    + rule : String
    + result : Evaluation
    + code : ReasonCode
    + location : Location
    + detail : String
    + origin : Origin
  }
  class ReasonCode <<record>> {
    + value : String
    + severity : Severity
  }
  enum Severity {
    VIOLATION
    WARNING
    NOTICE
  }
  class Location <<record>> {
    + file
    + pointer
  }
  class Origin {
    an opaque element identifier
    the kernel never names a pack
  }
}

package "packs.domain (owns HOW to walk)" {
  class "ValidationWalker<N>" as ValidationWalker {
    a visitor, never a driver
    OnNode checks (a node kind, a predicate, a rule) and OnClose checks
    phases: a violation gates later phases
    + run(traversal) : Ledger
  }
  class GraphCheck <<record>> {
    + walk : PackGraph.Walk
    + phases
    + run(graph, scope) : Ledger
  }
  class Ledger <<record>> {
    the ClosureFaults, in order
    interim: settles on Rationale in slice 7
  }
  class ClosureFault {
    a Reason with its packs,\nviolations and requiredBy
  }
  interface PackGraphNode {
    sealed
  }
  class PackNode
  class ArtifactNode
  class EdgeNode
  enum EdgeKind {
    DEPENDS_ON
    PARENT_PACK
    OVERRIDES
    ENHANCES
    SPECIALIZES
    REFERENCES
    STEP_LINK
    DELEGATES
  }
  class Scope <<record>> {
    + roots
    + selection : Predicate<PackGraphNode>
    given by the caller; a selection filter only
  }
  class PackGraph {
    built over a closure's packs, one thread
    + {static} of(packs, factsOf)
    + walk(scope, mode, visitor)
    stable order, cycles, strongly connected groups
  }
  class PackRulesets <<rule factory>> {
    + {static} content()
    + {static} closure()
    + {static} references(..)
    + {static} ownClosure(..) : GraphCheck
    + {static} ownClosureOf(declaring) : Scope
    ~ {static} referencesCheck(..) : GraphCheck
    + {static} relations()
    + {static} mutability(policies) <<proposed>>
    + {static} dependents() <<proposed>>
    + {static} activeSet(..) / selection(..) <<proposed>>
    + {static} ancestorsOf(..) / closuresHolding(..) <<proposed>>
  }
}

package "edge (ports and adapters)" {
  class PackRegistrationController <<driving adapter>>
  class PackDoctorMain <<CLI>>
  class PackCheck <<validate mode>>
  class PackRefusals {
    Rationale -> CharterRefusal
  }
  class PackVerdicts {
    Rationale -> report and exit code
  }
  class CharterRefusal <<kernel.domain>> {
    the edge's refusal: code + violations
  }
}

ValidationWalker ..|> GraphWalker
GraphWalker ..> Descent
ModularRuleset ..|> Rule
Constraint ..|> Rule
ModularRuleset o-- Rule
ValidationWalker --> Ledger : appends
Ledger o-- ClosureFault
ClosureFault --> Reason
GraphCheck --> ValidationWalker : runs its phases
GraphCheck --> PackGraph : walks
Rationale o-- Reason
Reason --> ReasonCode
ReasonCode --> Severity
Reason --> Location
Reason --> Origin

PackNode ..|> PackGraphNode
ArtifactNode ..|> PackGraphNode
EdgeNode ..|> PackGraphNode
EdgeNode --> EdgeKind
PackRulesets ..> EdgeKind : each check decides\nwhich edges it follows
PackRulesets ..> Origin : fills from a pack id,\nor pack id + URN
PackGraph --> Scope : walks within
PackGraph --> GraphWalker : drives (the one driver)
PackRulesets ..> Scope : builds
PackRulesets ..> GraphCheck : hands out
PackRulesets ..> ModularRuleset : builds

PackRegistrationController ..> PackRulesets : imports rules and scope
PackDoctorMain ..> PackCheck
PackCheck ..> PackRulesets : imports rules and scope
PackRegistrationController ..> PackRefusals
PackCheck ..> PackVerdicts
PackRefusals ..> CharterRefusal
PackRefusals ..> Rationale
PackVerdicts ..> Rationale

legend right
  Green <<proposed>>: approved target design, not built yet (ADR-0082 and its 2026-11-21 amendment).
  Every other class exists today. No mode of the driver emits an ArtifactNode yet.
endlegend
@enduml
