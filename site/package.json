{
  "name": "spec-kitty-charter-docsite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The spec-kitty-charter documentation site, built from ../docs with the published @spec-kitty/doc-toolkit.",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "predev": "node scripts/stage-docs-inputs.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/stage-docs-inputs.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "validate": "dockitty-validate-frontmatter ../docs && dockitty-check-links ../docs",
    "check:built-links": "dockitty-assert-no-broken-links dist --base /spec-kitty-charter --site https://spec-kitty.github.io",
    "check:okf": "dockitty-export-okf --dist dist --docs ../docs --out okf-export --index-basename README --base /spec-kitty-charter --site-url https://spec-kitty.github.io",
    "check:docs": "python3 ../scripts/docs/check_docs.py all"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/sitemap": "^3.2.0",
    "@astrojs/starlight": "^0.42.6",
    "@spec-kitty/doc-toolkit": "0.7.0",
    "astro": "^7.4.0",
    "sharp": "^0.34.5",
    "starlight-openapi": "0.27.0"
  },
  "overrides": {
    "form-data": "4.0.6"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "typescript": "^5.9.3"
  }
}
