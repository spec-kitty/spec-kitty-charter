{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.spec-kitty.ai/charter/packs/directive.schema.json",
  "$defs": {
    "Enforcement": {
      "description": "Enforcement level for a directive.\n\nOrdering is rank-driven (:data:`_ENFORCEMENT_RANK`), not the lexical\n``str`` comparison ``StrEnum`` would otherwise inherit -- see\n:meth:`__lt__`. ``==``, hashing, and JSON/str serialization are\nuntouched: only the four ordering dunders are overridden, so\n``Enforcement.REQUIRED == \"required\"`` and\n``json.dumps(Enforcement.REQUIRED)``-style value serialization keep\nworking exactly as before (FR-001).",
      "enum": [
        "required",
        "lenient-adherence",
        "advisory"
      ],
      "title": "Enforcement",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A constraint-oriented governance rule.\n\nDirectives define WHAT must be done (or avoided) with an enforcement\nlevel. Relationships to the tactics that describe HOW live in\n``packs/built-in/*.graph.yaml`` as typed edges; they are no longer embedded\nas inline ``tactic_refs`` on this model.",
  "properties": {
    "id": {
      "pattern": "^[A-Z][A-Z0-9_-]*$",
      "maxLength": 64,
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "intent": {
      "title": "Intent",
      "type": "string"
    },
    "enforcement": {
      "$ref": "#/$defs/Enforcement"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    },
    "integrity_rules": {
      "items": {
        "type": "string"
      },
      "title": "Integrity Rules",
      "type": "array"
    },
    "validation_criteria": {
      "items": {
        "type": "string"
      },
      "title": "Validation Criteria",
      "type": "array"
    },
    "explicit_allowances": {
      "items": {
        "type": "string"
      },
      "title": "Explicit Allowances",
      "type": "array"
    }
  },
  "required": [
    "id",
    "schema_version",
    "title",
    "intent",
    "enforcement"
  ],
  "title": "Directive",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "enforcement": {
            "const": "lenient-adherence"
          }
        },
        "required": [
          "enforcement"
        ]
      },
      "then": {
        "properties": {
          "explicit_allowances": {
            "minItems": 1
          }
        },
        "required": [
          "explicit_allowances"
        ]
      }
    }
  ]
}
