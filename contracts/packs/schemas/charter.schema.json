    "RetrospectiveGovernance": {
      "description": "The authored ``governance.retrospective:`` block of ``charter.yaml``.\n\nFR-005a of mission ``doctrine-charter-split-unification``. Before this\nmodel existed, ``GovernanceConfig`` had no ``retrospective`` field, so an\noperator-authored block was silently DROPPED on\n``GovernanceConfig.model_validate`` and the retrospective policy could only\nresolve from ``charter.md`` YAML frontmatter — a *resolving* read of the\ndisplay-only companion, the invariant violation FR-005 closes.\n\nKeys mirror ``retrospective.policy._KNOWN_KEYS`` exactly so the block can be\nhanded to ``_apply_block_to_policy`` verbatim. As with\n:class:`RetrospectiveGovernancePermissions`, every field is optional and\ndefaults to ``None`` (== unclaimed), so a partial charter block overrides\nonly the keys it actually authors.",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "timing": {
          "anyOf": [
            {
              "enum": [
                "post_completion",
                "before_completion"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timing"
        },
        "failure_policy": {
          "anyOf": [
            {
              "enum": [
                "warn",
                "block"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Policy"
        },
        "write_record": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Write Record"
        },
        "generate_proposals": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generate Proposals"
        },
        "apply_proposals": {
          "anyOf": [
            {
              "enum": [
                "require_human",
                "low_risk_auto"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Apply Proposals"
        },
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrospectiveGovernancePermissions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "precedence": {
          "anyOf": [
            {
              "enum": [
                "charter",
                "config"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precedence"
        },
        "generator": {
          "anyOf": [
            {
              "const": "python",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator"
        },
        "strict_keys": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strict Keys"
        }
      },
      "title": "RetrospectiveGovernance",
      "type": "object",
      "additionalProperties": false
    },
    "RetrospectiveGovernancePermissions": {
      "description": "Granular retrospective capability flags, as authored in ``charter.yaml``.\n\nPURE DATA (mission ``doctrine-charter-split-unification`` FR-005a,\nresearch.md D3): the runtime counterpart\n``specify_cli.retrospective.policy.RetrospectivePermissions`` is deliberately\nNOT imported here — the charter layer must not depend upward on\n``specify_cli`` (policed by the FR-008 architectural gate). The two shapes\nare kept key-for-key aligned instead, and the resolver reads this block as a\nplain dict.\n\nEvery flag is three-state ``bool | None``: ``None`` == \"the charter does not\nclaim this key\", which is what keeps ``charter.md`` frontmatter a\n*contributing* secondary source (C-003) rather than being wholesale\noverridden by invented defaults. The runtime defaults live in\n``retrospective.policy.default_policy`` and are applied there, never here.",
      "properties": {
        "write_record": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Write Record"
        },
        "inspect_mission_artifacts": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inspect Mission Artifacts"
        },
        "propose_glossary_changes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Propose Glossary Changes"
        },
        "propose_drg_changes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Propose Drg Changes"
        },
        "propose_doctrine_changes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Propose Doctrine Changes"
        },
        "apply_low_risk_changes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Apply Low Risk Changes"
        },
        "apply_structural_changes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Apply Structural Changes"
        }
      },
      "title": "RetrospectiveGovernancePermissions",
      "type": "object",
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "description": "The structured shape of the git-tracked, authorable ``charter.yaml``.\n\nContract: ``kitty-specs/consolidate-charter-bundle-01KXSYB9/contracts/\ncharter-yaml-schema.md``.\n\n⚠ Activation is FLAT AT THE ROOT (paula BLOCKER-1) — the ten\n``activated_*`` / ``mission_type_activations`` fields below are NOT\nnested under an ``activation:`` key, matching the activation presets\n(``packs/built-in/presets/<name>.yaml``), so\n``pack_context._read_activated_*`` / ``_read_list_key`` and\n``activation_engine.commit_plan`` read/write them unchanged.\n``model_config`` forbids extra fields, which doubles as the structural\nguard against a stray nested ``activation:`` mapping creeping back in\n(a nested mapping is not a declared field on this model, so\n``extra=\"forbid\"`` rejects it).\n\nEach ``activated_*`` field is three-state (charter contract G3):\n``None`` == absent key == the kind is unrestricted (every available\nartifact of it is effective); ``[]`` == explicit fail-closed empty; a\nnon-empty list == the activated set.",
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "governance": {
      "$ref": "#/$defs/GovernanceConfig"
    },
    "directives": {
      "$ref": "#/$defs/DirectivesConfig"
    },
    "catalog": {
      "$ref": "#/$defs/CharterCatalog"
    },
    "activated_kinds": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activated Kinds"
    },
    "mission_type_activations": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mission Type Activations"
    },
    "activated_directives": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activated Directives"
    },
    "activated_tactics": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activated Tactics"
    },
    "activated_styleguides": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activated Styleguides"
    },
    "activated_toolguides": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activated Toolguides"
    },
    "activated_paradigms": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activated Paradigms"
    },
    "activated_procedures": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activated Procedures"
    },
    "activated_agent_profiles": {
      "anyOf": [
        {
          "items": {
