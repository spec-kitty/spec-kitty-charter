          "type": "array"
        },
        "retrospective": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetrospectiveGovernance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enforcement": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Enforcement",
          "type": "object"
        }
      },
      "title": "GovernanceConfig",
      "type": "object",
      "additionalProperties": false
    },
    "PerformanceConfig": {
