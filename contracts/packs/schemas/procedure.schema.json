{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.spec-kitty.ai/charter/packs/procedure.schema.json",
  "$defs": {
    "ArtifactKind": {
      "description": "The kernel artifact-kind tokens a reference may name.",
      "enum": [
        "directive",
        "tactic",
        "styleguide",
        "toolguide",
        "paradigm",
        "procedure",
        "agent_profile",
        "mission_step_contract",
        "template",
        "asset",
        "glossary_pack",
        "anti_pattern",
        "skill"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "AntiPatternEntry": {
      "additionalProperties": false,
      "description": "Something to avoid when following the procedure; a value of its procedure, with no identity.",
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "bad_example": {
          "title": "Bad Example",
          "type": "string"
        },
        "good_example": {
          "title": "Good Example",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "AntiPatternEntry",
      "type": "object"
    },
    "ProcedureStep": {
      "additionalProperties": false,
      "description": "A single step within a procedure. A step names the role that acts (ADR-0032), never an agent profile.",
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "role": {
          "description": "An open role token, for example operator; absent when any role may act.",
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Role",
          "type": "string"
        },
        "on_success": {
          "title": "On Success",
          "type": "string"
        },
        "on_failure": {
          "title": "On Failure",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "ProcedureStep",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "description": "A cross-artifact reference, stored verbatim; a procedure's references are never minted as relationships.",
      "properties": {
        "type": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "when": {
          "title": "When",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A reusable orchestrated workflow with entry and exit conditions: ordered steps, each naming the role that acts.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "entry_condition": {
      "minLength": 1,
      "title": "Entry Condition",
      "type": "string"
    },
    "exit_condition": {
      "minLength": 1,
      "title": "Exit Condition",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/ProcedureStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "anti_patterns": {
      "items": {
        "$ref": "#/$defs/AntiPatternEntry"
      },
      "title": "Anti Patterns",
      "type": "array"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "References",
      "type": "array"
    },
    "notes": {
      "minLength": 1,
      "title": "Notes",
      "type": "string"
    },
    "applies_to_languages": {
      "items": {
        "type": "string"
      },
      "title": "Applies To Languages",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "entry_condition",
    "exit_condition",
    "steps"
  ],
  "title": "Procedure",
  "type": "object"
}
