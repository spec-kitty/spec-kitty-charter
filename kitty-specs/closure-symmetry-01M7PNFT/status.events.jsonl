{"aggregate_id": "01M7PNFTY2WEHNNV3A38K7EQK7", "aggregate_type": "Mission", "event_id": "01M7PNFVMJDE70T1P2TBFX4X36", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-18T06:28:45.187489+00:00", "friendly_name": "Closure symmetry: one closure rule on every path", "mission_id": "01M7PNFTY2WEHNNV3A38K7EQK7", "mission_number": null, "mission_slug": "closure-symmetry-01M7PNFT", "mission_type": "software-dev", "purpose_context": "A pack author's validation run and a per-file write must not pass a guard, lifecycle or mission type that the service then drops at load. The closure moves into the PACK ruleset as one domain rule, every path calls it, and one symmetry table proves it; a flaky concurrency test on the same write locks is made to report starvation precisely (#355, #593).", "purpose_tldr": "Every path that judges a pack (load, whole-pack write, validate mode, per-file write) applies the same guard, lifecycle and mission-template closure rule.", "target_branch": "feat/355-closure-in-pack-ruleset", "wp_count": 0}, "project_slug": "spec-kitty-charter", "project_uuid": "b419ff4a-d044-49f5-82a4-72132f63814f", "schema_version": "5.0.0", "timestamp": "2026-11-18T06:28:45.330497+00:00"}
