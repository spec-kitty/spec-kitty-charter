        "E hides T anyway",
        "Other"
      ],
      "origin_flow": "plan",
      "other_answer": true,
      "question": "Active E overrides T where T is required or locked?",
      "rationale": null,
      "resolved_at": "2026-11-06T09:40:01.107302Z",
