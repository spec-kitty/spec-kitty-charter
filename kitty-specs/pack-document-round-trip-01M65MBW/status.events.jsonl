{"at": "2026-10-30T05:30:42.127635+00:00", "event_id": "01M65MKX2FG5E5SAM9D57BX2AF", "event_type": "DecisionPointOpened", "payload": {"actor_id": "claude", "actor_type": "human", "decision_point_id": "01M65MKX2FG5E5SAM9D57BX2AE", "input_key": "pack_document_type", "mission_id": "01M65MBWAE8VZM6W97DTHDKMQT", "mission_slug": "pack-document-round-trip-01M65MBW", "mission_type": "software-dev", "options": ["A domain PackDocument with the markdown model shape (frontmatter, title, preamble, sections) plus an infra mapper to and from MarkdownDocument, as #194 did for Guide/GuideMarkdown", "Move MarkdownDocument into the domain or kernel", "Other"], "origin_flow": "specify", "origin_surface": "planning_interview", "phase": "SPECIFY", "question": "The domain cannot depend on infra (HexagonalArchitectureTest), and MarkdownDocument is infra. How does Pack hold the document while being typed as #194's markdown value?", "recorded_at": "2026-10-30T05:30:42.127635Z", "run_id": "01M65MKX2FG5E5SAM9D57BX2AE", "state_entered_at": "2026-10-30T05:30:42.127097Z", "step_id": "specify.pack_document_type"}}
