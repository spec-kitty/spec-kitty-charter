{"aggregate_id": "01M65MBWAE8VZM6W97DTHDKMQT", "aggregate_type": "Mission", "event_id": "01M65MBXJ2HAVHN6SHTZJ0GGZF", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-10-30T05:26:20.119630+00:00", "friendly_name": "Round-trip pack.md through the markdown content form", "mission_id": "01M65MBWAE8VZM6W97DTHDKMQT", "mission_number": null, "mission_slug": "pack-document-round-trip-01M65MBW", "mission_type": "software-dev", "purpose_context": "Issue #260, split from #195 under epic #186: the pack's Markdown description is the last pack-level file the whole-pack round-trip gate lists as other:pack.md. #194's first PR built the markdown content form (MarkdownDocument, MarkdownCodec); this mission uses that form to hold pack.md in the Pack aggregate, write it in WholePackStore, cover it in the source fingerprint between the presets and pack-manifest.yaml (ADR-0043 decision 9) and model it in the gate as pack-document.", "purpose_tldr": "Each pack's pack.md is read into the Pack aggregate as a Markdown document and written back with the same meaning, so the whole-pack gate goes green on it.", "target_branch": "issue-260-pack-md-round-trip", "wp_count": 0}, "project_slug": "spec-kitty-charter", "project_uuid": "b419ff4a-d044-49f5-82a4-72132f63814f", "schema_version": "5.0.0", "timestamp": "2026-10-30T05:26:20.482732+00:00"}
