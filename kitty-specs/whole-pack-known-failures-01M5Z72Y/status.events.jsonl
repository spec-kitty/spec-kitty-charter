{"aggregate_id": "01M5Z72Y0HB97SQF4P7V832TJF", "aggregate_type": "Mission", "event_id": "01M5Z72ZRPB78WN4PPHJQR8B0R", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-10-27T17:38:49.280763+00:00", "friendly_name": "Whole-pack gate known-failure list", "mission_id": "01M5Z72Y0HB97SQF4P7V832TJF", "mission_number": null, "mission_slug": "whole-pack-known-failures-01M5Z72Y", "mission_type": "software-dev", "purpose_context": "ADR-0036 rules that a pack file failing the round trip because of a pack inconsistency is fixed in spec-kitty-open-packs, not worked around here. Until the pinned open-packs commit carries the fix, the gate needs a place to record that failure. This mission adds a known-failure list, kept apart from the expected-red baseline and the exclusions, keyed by the open-packs issue and the file. It expires itself: a listed file that passes fails the gate with a message to remove the entry, so the list cannot go stale after the pin moves (issue #247).", "purpose_tldr": "Let the whole-pack round-trip gate carry pack files that fail because of an open-packs defect awaiting an upstream fix, without going red, and fail as soon as the fix lands.", "target_branch": "feat/whole-pack-known-failures", "wp_count": 0}, "project_slug": "spec-kitty-charter", "project_uuid": "b419ff4a-d044-49f5-82a4-72132f63814f", "schema_version": "5.0.0", "timestamp": "2026-10-27T17:38:49.750298+00:00"}
