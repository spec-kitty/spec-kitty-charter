{"aggregate_id": "01M7SS5GZZQ1X2TYWEJ570X0RK", "aggregate_type": "Mission", "event_id": "01M7SS5HVGV8WEJQ19RSQGEWZ8", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-19T11:30:45.139392+00:00", "friendly_name": "Pack id split: the registered pack id and the descriptor ULID", "mission_id": "01M7SS5GZZQ1X2TYWEJ570X0RK", "mission_number": null, "mission_slug": "pack-id-split-01M7SS5G", "mission_type": "software-dev", "purpose_context": "PackIdentifier carries three different values today (the registered slug, the descriptor ULID and the descriptor name), so its constructor can only check for blank text and a hand-seeded directory such as a--b is read and served though every write refuses it. The pack id is guarded as slug(63), the descriptor identity gets its own kernel type that the edge and closure indexes key by, staging and dropped-pack sites name what they hold, and fixtures use the type that fits (#583, ADR-0075 decision 2, #552 Q3 ruling b).", "purpose_tldr": "A pack's registered id and its descriptor's pack_id are two typed identities, and a stored pack whose directory name is not a pack id is refused on read.", "target_branch": "feat/583-pack-id-split", "wp_count": 0}, "project_slug": "spec-kitty-charter", "project_uuid": "b419ff4a-d044-49f5-82a4-72132f63814f", "schema_version": "5.0.0", "timestamp": "2026-11-19T11:30:45.232716+00:00"}
