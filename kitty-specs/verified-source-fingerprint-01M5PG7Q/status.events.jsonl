{"aggregate_id": "01M5PG7QXA69H5WSN7WEPR2W2A", "aggregate_type": "Mission", "event_id": "01M5PG7RZ14NC5883H06C3W7GG", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-10-24T08:25:33.728668+00:00", "friendly_name": "Verified source fingerprint on every read", "mission_id": "01M5PG7QXA69H5WSN7WEPR2W2A", "mission_number": null, "mission_slug": "verified-source-fingerprint-01M5PG7Q", "mission_type": "software-dev", "purpose_context": "The core CLI relies on the service's source fingerprint to know whether an answer is fresh. Today the tactic reads send no fingerprint at all, and the fingerprint the service computes leaves out the tactic, directive, styleguide and paradigm files it loads. This mission makes the fingerprint cover exactly the loaded files from one shared list, restores the before-and-after check on every read, and sends the verified fingerprint on every successful read (issues #120 and #173).", "purpose_tldr": "Every read answers with a freshness fingerprint that covers exactly the pack files it loaded, and refuses when they changed underneath it.", "target_branch": "fix/verified-source-fingerprint", "wp_count": 0}, "project_slug": "spec-kitty-charter", "project_uuid": "b419ff4a-d044-49f5-82a4-72132f63814f", "schema_version": "5.0.0", "timestamp": "2026-10-24T08:25:33.921572+00:00"}
