{"aggregate_id": "01M693YFV1BKNCN56N0MXYRFXP", "aggregate_type": "Mission", "event_id": "01M693YH9CZ5GC18Z4HNHBEHMR", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-10-31T13:56:21.934427+00:00", "friendly_name": "Service release line and native packaging", "mission_id": "01M693YFV1BKNCN56N0MXYRFXP", "mission_number": null, "mission_slug": "service-release-native-01M693YF", "mission_type": "software-dev", "purpose_context": "Issues #241 and #71. Operator rulings 2026-10-31 (spec-kitty#6117): a service-v* tag line separate from contract-charter-v*; native per OS for linux-x64, linux-arm64, macos-arm64 and windows-x64 with the jar as fallback at 4.0.0 GA; core pins the service and fetches it on first use. This mission records the ADR, adds the GraalVM native build and smoke test in CI and a service-release workflow; it pushes no tag.", "purpose_tldr": "The charter service releases on its own service-v* tag line with native binaries for four OS targets plus the jar, checksummed and attested, named as core's pin model expects.", "target_branch": "issue-241-71-service-release-native", "wp_count": 0}, "project_slug": "spec-kitty-charter", "project_uuid": "b419ff4a-d044-49f5-82a4-72132f63814f", "schema_version": "5.0.0", "timestamp": "2026-10-31T13:56:22.445004+00:00"}
