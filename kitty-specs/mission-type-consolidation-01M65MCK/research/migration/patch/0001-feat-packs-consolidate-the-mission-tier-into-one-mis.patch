-# Expected artifact manifest for software-dev mission
-#
-# Defines which artifacts are required/optional at each mission step.
-# Step names correspond to mission.yaml state IDs.
-#
-# Blocking semantics:
-# - blocking: true means missing artifact prevents mission advancement
-# - blocking: false means missing artifact is noted but doesn't block
-#
-# Path patterns support glob syntax (e.g., tasks/*.md matches all .md files in tasks/)
-
-schema_version: "1.0"
-mission_type: "software-dev"
-# manifest_version is a sync-namespace identity key (feeds NamespaceRef), not
-# a content-freshness counter; do not bump on content-only changes.
-manifest_version: "1"
-
-# Artifacts required regardless of mission step
-required_always: []
-
-# Artifacts required at specific mission steps
-required_by_step:
-  discovery:
-    # Discovery step has no required artifacts
-    []
-
-  specify:
-    - artifact_key: "input.spec.main"
-      artifact_class: "input"
-      path_pattern: "spec.md"
-      blocking: true
-
-  plan:
-    # Plan step requires only plan.md (matches _evaluate_software_dev_guards'
-    # "plan" branch); tasks.md is produced/checked by the separate CLI-native
-    # tasks_outline/tasks_packages/tasks_finalize steps below.
-    - artifact_key: "output.plan.main"
-      artifact_class: "output"
-      path_pattern: "plan.md"
-      blocking: true
-
-  tasks_outline:
-    - artifact_key: "output.tasks.index"
-      artifact_class: "output"
-      path_pattern: "wps.yaml"
-      blocking: true
-
-  tasks_packages:
-    # _evaluate_tasks_packages_guard also enforces requirement_mapping_failures,
-    # a non-filesystem-expressible check this schema has no field for.
-    - artifact_key: "output.tasks.per_wp"
-      artifact_class: "output"
-      path_pattern: "tasks/WP*.md"
-      blocking: true
-
-  tasks_finalize:
-    # _evaluate_tasks_finalize_guard also enforces the occurrence gate and
-    # dependency-frontmatter checks, non-filesystem-expressible checks this
-    # schema has no field for.
-    - artifact_key: "output.tasks.per_wp"
-      artifact_class: "output"
-      path_pattern: "tasks/WP*.md"
-      blocking: true
-    - artifact_key: "output.tasks.list"
-      artifact_class: "output"
-      path_pattern: "tasks.md"
-      blocking: true
-
-  implement:
-    # Implement has no filesystem requirement of its own:
-    # _evaluate_wp_iteration_guard only checks WP status (wp_advance_ready),
-    # never analysis-report.md on disk. The analysis report is gated one step
-    # earlier, at the `analyze` step (an analysis-currency check, not a
-    # filesystem-presence check), so by the time implement runs a current
-    # analysis report is already guaranteed. The implement guard itself is
-    # intentionally left unchanged.
