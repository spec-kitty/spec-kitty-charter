+  role: researcher
+  prompt_path: steps/methodology.prompt.md
+  guidelines_path: steps/methodology.guidelines.md
+  expected_output_artifacts:
+  - artifact_key: workflow.plan.methodology
+    artifact_class: workflow
+    path_pattern: plan.md
+    blocking: true
+    template_path: templates/research-plan-template.md
+  references:
+  - type: directive
+    id: DIRECTIVE_003
+  - type: directive
+    id: DIRECTIVE_010
+  - type: tactic
+    id: adr-drafting-workflow
+  - type: tactic
+    id: requirements-validation-workflow
+- id: gathering
+  title: Source Gathering
+  description: Register sources with citations and emit source_documented events.
+  role: researcher
+  prompt_path: steps/gathering.prompt.md
+  guidelines_path: steps/gathering.guidelines.md
+  expected_output_artifacts:
+  - artifact_key: evidence.source-register
+    artifact_class: evidence
+    path_pattern: source-register.csv
+    blocking: true
+  references:
+  - type: directive
+    id: DIRECTIVE_003
+  - type: directive
+    id: DIRECTIVE_037
+  - type: tactic
+    id: requirements-validation-workflow
+- id: synthesis
+  title: Findings Synthesis
+  description: Synthesize evidence into findings, tracing each conclusion to documented sources.
+  role: researcher
+  prompt_path: steps/synthesis.prompt.md
+  guidelines_path: steps/synthesis.guidelines.md
+  expected_output_artifacts:
+  - artifact_key: output.findings.main
+    artifact_class: output
+    path_pattern: findings.md
+    blocking: true
+  references:
+  - type: directive
+    id: DIRECTIVE_003
+  - type: directive
+    id: DIRECTIVE_010
+  - type: tactic
+    id: premortem-risk-identification
+  - type: tactic
+    id: requirements-validation-workflow
+- id: output
+  title: Publication Output
+  description: Prepare findings for publication; verify citation completeness and methodology clarity.
+  role: reviewer
