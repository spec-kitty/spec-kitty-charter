+- id: plan
+  title: Plan (caveman)
+  description: Produce the implementation plan; decisions stated outcome-first.
+  role: planner
+  prompt_path: steps/plan.prompt.md
+  expected_output_artifacts:
+  - artifact_key: workflow.plan.cave-dev
+    artifact_class: workflow
+    path_pattern: plan.md
+    blocking: true
+- id: tasks
+  title: Tasks (caveman)
+  description: Decompose into work packages.
+  role: planner
+  prompt_path: steps/tasks.prompt.md
+  expected_output_artifacts:
+  - artifact_key: workflow.tasks.cave-dev
+    artifact_class: workflow
+    path_pattern: tasks.md
+    blocking: true
+- id: analyze
+  title: Analyze (caveman)
+  description: Cross-artifact consistency and readiness check before implement; verdict outcome-first, references exact.
+  role: reviewer
+  prompt_path: steps/analyze.prompt.md
+- id: implement
+  title: Implement (caveman)
+  description: Build the work package; progress replies terse, code and commands exact.
+  role: implementer
+  prompt_path: steps/implement.prompt.md
+- id: review
+  title: Review (caveman)
+  description: Review the work; findings outcome-first, evidence exact, risks in full sentences.
+  role: reviewer
+  prompt_path: steps/review.prompt.md
+- id: accept
+  title: Accept (caveman)
+  description: Confirm the result against the spec and record the decision.
+  role: reviewer
+  prompt_path: steps/accept.prompt.md
