+schema_version: '1.0'
+id: cave-dev
+title: Cave Dev
+description: The software-development lifecycle, re-voiced in the caveman terse output style. Same eight canonical steps and the same engineering rigour as software-dev; only the agent's output prose is compressed (outcome-first, filler cut, payloads and negations kept exact).
+references:
+- type: directive
+  id: CAVE_001
+- type: styleguide
+  id: cave-sty-001-communication
+steps:
+- id: discovery
+  title: Discovery (caveman)
+  description: Investigate before specifying; report findings outcome-first, quoted source verbatim.
+  role: researcher
+  prompt_path: steps/discovery.prompt.md
+- id: specify
+  title: Specify (caveman)
+  description: Write the spec. Acceptance criteria precise and complete; surrounding prose terse.
+  role: analyst
+  prompt_path: steps/specify.prompt.md
+  expected_output_artifacts:
+  - artifact_key: input.spec.cave-dev
+    artifact_class: input
+    path_pattern: spec.md
