+get:
+  operationId: getActivationMissionType
+  summary: Get the mission type in force under an activation, with its steps and skeletons.
+  description: >-
+    It answers the layer-merge winner of the mission type in the activation's merged closure, in the Artifact envelope as
+    getPackMissionType does, with packId the pack that holds the winner; its steps and skeletons link to
+    getActivationMissionStep and getActivationMissionSkeleton, and its skeletons are those of the pack that holds the
+    winner. An unknown activation is a 404 activation_not_found, then a mission type the merged closure does not hold
+    is a 404 mission_type_not_found; a closure that cannot merge is a 500 with its code. No ETag.
+  tags:
+    - MissionTypes
+  parameters:
+    - $ref: ../parameters/ActivationId.yaml
+    - $ref: ../parameters/MissionTypeId.yaml
+  responses:
+    '200':
+      description: The mission type in force, in the Artifact envelope.
+      headers:
+        Charter-Contract-Version:
+          $ref: ../headers/CharterContractVersion.yaml
+        Charter-Worktree:
+          $ref: ../headers/CharterWorktree.yaml
+        Charter-Source-Fingerprint:
+          $ref: ../headers/CharterSourceFingerprint.yaml
+      content:
+        application/json:
+          schema:
+            $ref: ../schemas/Artifact.yaml
+          examples:
+            software-dev:
+              $ref: ../examples/Artifact.activation-mission-type.yaml
+    '400':
+      $ref: ../../_shared/responses/Problem.yaml
+    '401':
+      $ref: ../responses/Unauthorized.yaml
+    '403':
+      $ref: ../responses/Forbidden.yaml
+    '404':
+      $ref: ../responses/ActivationMissionTypeNotFound.yaml
+    '500':
+      $ref: ../responses/OfferingUnreadable.yaml
+    default:
+      $ref: ../../_shared/responses/Problem.yaml
