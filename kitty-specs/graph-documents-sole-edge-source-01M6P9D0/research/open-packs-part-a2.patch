@@ -0,0 +1,19 @@
+schema_version: '1.0'
+id: agent-commit-signing
+title: Agent Commit Signing
+description: |
+  Create agent-authored commits without depending on signing keys, and document any case that needs a human-signed commit instead.
+entry_condition: |
+  An agent is about to create a commit in a local, CI, worktree, or ephemeral environment.
+exit_condition: |
+  The agent-authored commit was created with signing disabled, and any exception that requires a human-authored signed commit is documented.
+steps:
+- title: Commit with signing disabled
+  description: |
+    Use `git commit --no-gpg-sign` or `git -c commit.gpgsign=false commit` for agent-authored commits.
+- title: Do not assume signing keys are available
+  description: |
+    Do not assume signing keys are available in CI, worktrees, or ephemeral development environments.
+- title: Document human-signing exceptions
+  description: |
+    Document any exception that requires human-authored signed commits outside the agent workflow.
diff --git a/packs/built-in/procedures/agent-self-declaration.procedure.yaml b/packs/built-in/procedures/agent-self-declaration.procedure.yaml
new file mode 100644
