{"aggregate_id": "01M68A0TEXMSGNRTQSR1X9C7ZE", "aggregate_type": "Mission", "event_id": "01M68A0VV69G42QYVXG96N420X", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-10-31T06:23:15.350944+00:00", "friendly_name": "DRG tension edges and node fields round-trip", "mission_id": "01M68A0TEXMSGNRTQSR1X9C7ZE", "mission_number": null, "mission_slug": "drg-tension-and-node-fields-01M68A0T", "mission_type": "software-dev", "purpose_context": "Epic #186 holds that open-packs YAML round-trips without loss of meaning (ADR-0036). The whole-pack gate found two DRG losses: #235, a tension edge (written in_tension_with) read as the retired signed impacts relation and written back as a plain impacts edge with no strength; and #236, graph-shard node tags and provenance and fragment node body_path dropped by the domain read and the shard writer. This bugfix keeps the tension relationship of ADR-0028 in the domain beside the structural relationships, writes it back as written, carries every declared node field through, and retires both expected-red entries through the gate's ratchet, with no HTTP contract change.", "purpose_tldr": "A graph shard's tension edges and its node tags, provenance and body paths come back from a read and write exactly as the pack author wrote them.", "target_branch": "issue-235-236-drg-round-trip", "wp_count": 0}, "project_slug": "spec-kitty-charter", "project_uuid": "b419ff4a-d044-49f5-82a4-72132f63814f", "schema_version": "5.0.0", "timestamp": "2026-10-31T06:23:15.814928+00:00"}
